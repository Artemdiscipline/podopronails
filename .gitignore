# В корень проекта постоянно падают исходники: фото из мессенджеров, сохранённые
# страницы. Имена и расширения у них случайные (бывает и вовсе без расширения),
# поэтому проще перечислить то, что В репозитории нужно, чем то, что не нужно.
/*
!/.gitignore
!/index.html
!/admin.html
!/admin.js
!/cms-defaults.js
!/site-content.js
!/firebase-config.js
!/firestore.rules
!/assets
!/.claude
!/firebase.json
# .firebaserc создаст `firebase init` — в нём id проекта, пусть тоже лежит в репозитории
!/.firebaserc
# CNAME понадобится при переезде на свой домен
!/CNAME
